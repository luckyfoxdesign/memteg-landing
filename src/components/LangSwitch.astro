---
import { locales, swapLocaleInPath, type Locale } from '~/i18n';

interface Props {
  current: Locale;
}
const { current } = Astro.props;
const pathname = Astro.url.pathname;
---

<div class="inline-flex items-center gap-0.5 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)]/60 p-0.5 text-[12px] font-mono backdrop-blur-md">
  {
    locales.map((loc) => {
      const href = swapLocaleInPath(pathname, loc);
      const active = loc === current;
      return (
        <a
          href={href}
          class:list={[
            'rounded-full px-2.5 py-1 transition-colors',
            active
              ? 'bg-[var(--color-ink)] text-[var(--color-bg)]'
              : 'text-[var(--color-muted)] hover:text-[var(--color-ink)]',
          ]}
          aria-current={active ? 'page' : undefined}
        >
          {loc.toUpperCase()}
        </a>
      );
    })
  }
</div>
