---
interface Props {
  h1: string;
  updated: string;
  intro: string;
}
const { h1, updated, intro } = Astro.props;
---

<article class="mx-auto w-full max-w-[800px] px-5 pb-24 pt-20 md:px-10 md:pb-32 md:pt-28">
  <header class="mb-12">
    <div class="mb-3 font-mono text-[12px] uppercase tracking-wider text-[var(--color-muted)]">{updated}</div>
    <h1 class="text-[clamp(36px,5vw,64px)] font-medium leading-[1.02] tracking-[-0.03em]">{h1}</h1>
    <p class="mt-5 text-[16px] leading-relaxed text-[var(--color-ink-2)]">{intro}</p>
  </header>
  <div class="prose-legal space-y-10">
    <slot />
  </div>
</article>

<style is:global>
  .prose-legal section h2 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin-bottom: 10px;
  }
  .prose-legal section p {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
</style>
