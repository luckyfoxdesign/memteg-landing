---
import { t, type Locale } from '~/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="relative">
  <div class="mx-auto w-full max-w-[1000px] px-5 py-24 md:px-10 md:py-32">
    <div class="max-w-2xl" data-reveal>
      <div class="mb-4 font-mono text-[12px] uppercase tracking-wider text-[var(--color-muted)]">
        {dict.faq.eyebrow}
      </div>
      <h2 class="text-[clamp(32px,4.5vw,56px)] font-medium leading-[1.02] tracking-[-0.03em]">
        {dict.faq.title}
      </h2>
    </div>

    <div class="mt-12 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]" data-reveal>
      {
        dict.faq.items.map((item) => (
          <details class="group">
            <summary class="flex cursor-pointer items-start justify-between gap-6 py-6 text-left list-none">
              <span class="text-[17px] font-medium leading-snug tracking-[-0.01em] md:text-[19px]">{item.q}</span>
              <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-[var(--color-line-strong)] text-[var(--color-muted)] transition-transform group-open:rotate-45">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M6 1.5v9M1.5 6h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="pb-6 pr-12 text-[15px] leading-relaxed text-[var(--color-muted)]">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
