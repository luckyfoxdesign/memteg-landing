---
import { t, type Locale } from '~/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="border-y border-[var(--color-line)] bg-[var(--color-bg-2)]">
  <div class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-10 md:py-24" data-reveal>
    <p class="text-[clamp(28px,4vw,52px)] font-medium leading-[1.05] tracking-[-0.025em] text-[var(--color-ink)]">
      {dict.quote.text}
    </p>
    <p class="mt-6 text-[16px] font-medium text-[var(--color-ink-2)] md:text-[18px]">
      <span class="text-[var(--color-accent)]">–</span> <span id="quote-author" style="transition: opacity 0.4s ease">{dict.quote.authors[0]}</span>
    </p>
  </div>
</section>

<script define:vars={{ authors: dict.quote.authors }}>
  const el = document.getElementById('quote-author');
  let i = 0;

  setInterval(() => {
    el.style.opacity = '0';
    setTimeout(() => {
      i = (i + 1) % authors.length;
      el.textContent = authors[i];
      el.style.opacity = '1';
    }, 400);
  }, 4000);
</script>
