---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2 font-medium tracking-tight ${className}`}>
  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
    <rect x="1" y="1" width="20" height="20" rx="6" fill="var(--color-ink)" />
    <path
      d="M6 15V7l3 5 3-5v8M14 11h3M14 15h3"
      stroke="var(--color-bg)"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="text-[15px]">memteg</span>
</span>
