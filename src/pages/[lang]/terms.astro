---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LegalLayout from '~/components/LegalLayout.astro';
import { locales, t, type Locale } from '~/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = t(lang);
const page = dict.termsPage;
---

<BaseLayout locale={lang} title={dict.meta.terms.title} description={dict.meta.terms.description}>
  <LegalLayout h1={page.h1} updated={page.updated} intro={page.intro}>
    {
      page.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          <p>{s.body}</p>
        </section>
      ))
    }
  </LegalLayout>
</BaseLayout>
